# Copy to lab.env (gitignored) and fill in. Non-secret settings only: never put access keys here.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
PROJECT_TAG=kinesis-lab
STREAM_NAME=lab-events
FIREHOSE_NAME=lab-events-to-s3
BUCKET_NAME=kinesis-lab-123456789012-us-east-1
ALERT_EMAIL=you@example.com
# Databricks CLI profile name (from ~/.databrickscfg), workspace user, and Unity Catalog external ID
# (shown as external_id by: databricks credentials list-credentials)
DATABRICKS_PROFILE=my-workspace
DATABRICKS_USER=you@example.com
DATABRICKS_EXTERNAL_ID=00000000-0000-0000-0000-000000000000
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=kinesis_lab
